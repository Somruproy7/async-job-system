# ═══════════════════════════════════════════════════════════
# RAILWAY ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# Copy these to Railway dashboard: Settings > Variables
# ═══════════════════════════════════════════════════════════

# ─── Security (CHANGE THESE!) ────────────────────────────────
SECRET_KEY=Sjl9ca7tWZoBzs643VEuuxdEm7m9J1-BJOcU7QLJRz8
DEBUG=false

# ─── Database (Railway will provide these) ───────────────────
# Add PostgreSQL plugin in Railway, it will auto-populate:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<auto-generated>
# POSTGRES_DB=railway

# ─── Redis (Railway will provide these) ──────────────────────
# Add Redis plugin in Railway, it will auto-populate:
# REDIS_URL=redis://default:pass@host:port
# CELERY_BROKER_URL=${REDIS_URL}/1
# CELERY_RESULT_BACKEND=${REDIS_URL}/2

# ─── Database Pool ────────────────────────────────────────────
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── Celery Queues ────────────────────────────────────────────
JOB_HIGH_PRIORITY_QUEUE=high
JOB_DEFAULT_QUEUE=default
JOB_LOW_PRIORITY_QUEUE=low

# ─── Job Configuration ────────────────────────────────────────
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=60
JOB_DEFAULT_TIMEOUT_SECONDS=3600

# ─── JWT Configuration ────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS (UPDATE WITH YOUR VERCEL URL!) ─────────────────────
ALLOWED_ORIGINS=["https://your-app.vercel.app"]
ALLOWED_HOSTS=["*"]

# ─── Port (Railway provides this) ─────────────────────────────
# PORT=<auto-provided-by-railway>
