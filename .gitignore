# ═══════════════════════════════════════════════════════════
# Git Ignore - Security & Build Files
# ═══════════════════════════════════════════════════════════

# Environment files (NEVER commit these!)
.env
.env.local
.env.production
.env.*.local

# SSL Certificates
nginx/ssl/
*.pem
*.key
*.crt

# Database backups
backups/
*.sql
*.sql.gz

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/

# Docker
*.log
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# Alembic
alembic/versions/*.pyc

# Temporary files
*.tmp
*.temp
.cache/
